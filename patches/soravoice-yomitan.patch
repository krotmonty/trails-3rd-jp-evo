+// Move/resize the game window as set in the ini (WindowX/Y, WindowWidth/Height = client size).
+void PlaceWindow(HWND hwnd, const Config* config) {
+    RECT r;
+    GetWindowRect(hwnd, &r);
+    int x = config->window_x >= 0 ? config->window_x : r.left;
+    int y = config->window_y >= 0 ? config->window_y : r.top;
+    int w = r.right - r.left, h = r.bottom - r.top;
+    if (config->window_width > 0 && config->window_height > 0) {
+        RECT c{ 0, 0, config->window_width, config->window_height };
+        AdjustWindowRectEx(&c, GetWindowLong(hwnd, GWL_STYLE), FALSE, GetWindowLong(hwnd, GWL_EXSTYLE));
+        w = c.right - c.left;
+        h = c.bottom - c.top;
+    }
+    SetWindowPos(hwnd, nullptr, x, y, w, h, SWP_NOZORDER | SWP_NOACTIVATE);
+    LOG("Window placed at %d,%d size %dx%d", x, y, w, h);
+}
