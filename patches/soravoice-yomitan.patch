+#ifndef __CORE_TEXT_FEED_H__
+#define __CORE_TEXT_FEED_H__
+
+#include <cstdint>
+
+namespace core {
+// Serve web_dir over http://localhost:port and push every dialog page shown in game to
+// WebSocket clients on the same port, as {"sentence": "...", "voice": "<voice file ID>"}
+// (texthooker-ui format). Also serves /voice/<ID>.ogg (the Evo clip) and /screenshot.jpg
+// (the game window), for Anki cards.
+bool StartTextFeed(int port, const char* web_dir, void* game_hwnd);
+
+// Open the page as a browser app window (the user's profile, so Yomitan is there). Docked: in the
+// free space right of the game window, or below it. Overlay: a borderless see-through strip of
+// the given height and opacity (percent) over the bottom of the game, following the game window.
+// edge: open it in Edge instead of Chrome.
+// Pressing expand_key (a virtual-key code) grows the overlay to expand_height, for Yomitan's popup.
+void OpenPageWindow(int port, void* game_hwnd, bool edge, bool overlay, int height, int expand_height,
+                    int expand_key, int opacity);
+
+// Called by the text hook for every printable character the game's text parser reaches.
+// p points at that character inside the scenario text (Shift-JIS).
+void OnTextChar(const uint8_t* p);
+}  // namespace core
+
+#endif  // __CORE_TEXT_FEED_H__
